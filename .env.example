# Application (НАМПАК)
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-here
ALLOWED_ORIGINS=http://136.234.4.160,https://136.234.4.160,http://localhost:3000,http://localhost:5173

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nampack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_password_here

# Redis (Cart)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# SMTP Email Notifications (Yandex 360 / Mail.ru)
# Отправка заявок менеджеру и подтверждений клиентам
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=nampack@yandex.ru
SMTP_PASSWORD=your_app_password
ADMIN_EMAIL=nampack@yandex.ru

# Telegram Bot Notifications (Оповещения о новых заявках)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Оплата и логистика (в режиме менеджера отключены; оставлены для совместимости)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_IS_TEST=true
CDEK_SENDER_CITY_CODE=

